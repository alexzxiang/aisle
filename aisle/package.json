{
  "name": "aisle",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-sensors": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:phrases": "tsx scripts/lint-phrases.ts",
    "lint:deps": "node -e \"const p=require('./package.json');const bad=['expo-av','expo-camera','react-native-vision-camera'].filter(k=>p.dependencies[k]||(p.devDependencies||{})[k]);if(bad.length){console.error('forbidden deps:',bad);process.exit(1)}\"",
    "gen:audio": "tsx scripts/generate-audio.ts",
    "gen:tones": "tsx scripts/generate-tones.ts",
    "proxy": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server",
    "lint": "npm run typecheck && npm run lint:deps && npm run lint:phrases",
    "start:mock": "EXPO_PUBLIC_MOCK=1 expo start --dev-client",
    "ios:device": "expo run:ios --device"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/",
      "<rootDir>/training/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/server/"
    ]
  }
}
