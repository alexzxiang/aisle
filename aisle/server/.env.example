# Aisle proxy configuration. Copy to .env and fill in the keys you need:
#
#   cp .env.example .env
#
# .env is git-ignored and must stay that way. Ask Alex for keys; never paste one
# into chat, a commit or an issue. CI has no keys and needs none — the whole test
# suite runs against fakes.
#
# `npm run doctor` tells you which of these the proxy is actually happy with.

# ---------------------------------------------------------------------------
# Required — /api/health reports these five red when missing
# ---------------------------------------------------------------------------

# Claude, for every vision call (the camera questions).
ANTHROPIC_API_KEY=

# Nemotron on the hosted NIM, for the planner jobs.
NVIDIA_API_KEY=

# ElevenLabs, for speech out and speech in. The voice id is a voice, not a secret,
# but the proxy treats a missing one as a missing key because TTS cannot run without it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Routes, for walking directions. Needs the Routes API enabled on the
# project and no referrer/IP restriction that would block a server call.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Second NVIDIA key, tried when the primary returns 429 or 5xx.
NVIDIA_API_KEY_FALLBACK=

# OpenRouter is the last rung of the planner failover, after both NVIDIA keys.
# Worth setting: live runs have seen Nemotron answer 429 Too Many Requests, which
# is exactly what this rung exists to absorb. Grey (never red) in /api/health.
OPENROUTER_API_KEY=

# Copy the exact Nemotron id from the authenticated GET /v1/models on day 0 —
# never from memory. Defaults are in config.ts.
NVIDIA_MODEL=
NVIDIA_MODEL_FALLBACK=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# PORT defaults to 8787, HOST to 0.0.0.0 so a phone on the same network can reach it.
PORT=
HOST=
REGION=

# WARMUP_ON_START=0 skips the schema warm-up when working offline.
WARMUP_ON_START=

# CAPTURE_FRAMES=1 saves every vision still, its on-device facts and Claude's answer
# to server/data/cache/frames (git-ignored) for the vision eval. Off by default: a
# captured frame is a photo of someone's home. See the README's "Vision eval" section.
CAPTURE_FRAMES=

# Base URLs — only set these to point at a mock or a different region.
NIM_BASE_URL=
OPENROUTER_BASE_URL=
ELEVENLABS_BASE_URL=
ELEVENLABS_WS_BASE_URL=
